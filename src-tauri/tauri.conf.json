{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MMS Desktop",
  "version": "1.0.0",
  "identifier": "com.sxpcwlkj.mms-desktop",
  "build": {
    "beforeDevCommand": "npx sirv-cli@3 dist --port 1420 --dev --single --host localhost --cors",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MMS Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "sxpcwlkj",
    "copyright": "Copyright © 2026 sxpcwlkj",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
